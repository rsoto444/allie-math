// Prisma schema for Allie's Math Practice
// SQLite locally; Turso (libSQL) in production via the driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Skill {
  id       String        @id @default(cuid())
  strand   String // topic label, e.g. "Fractions"
  key      String        @unique
  name     String
  order    Int
  grade    Int           @default(6)
  attempts Attempt[]
  mastery  SkillMastery?
}

// One row per skill Allie has proven, either 3/3 on a grade check-up or 7/8 on a mastery check.
model SkillMastery {
  id         String   @id @default(cuid())
  skillId    String   @unique
  skill      Skill    @relation(fields: [skillId], references: [id])
  via        String // "diagnostic" | "check"
  masteredAt DateTime @default(now())
}

model Attempt {
  id            String   @id @default(cuid())
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id])
  sessionId     String?
  mode          String // "practice" | "diagnostic" | "mastery" | "review"
  difficulty    Int
  prompt        String
  userAnswer    String
  correctAnswer String
  correct       Boolean
  createdAt     DateTime @default(now())

  @@index([skillId])
  @@index([sessionId])
  @@index([createdAt])
}

model AssessmentSession {
  id             String    @id @default(cuid())
  mode           String // "diagnostic" | "mastery" | "review"
  grade          Int? // diagnostic only
  skillKey       String? // mastery only
  plan           String? // JSON: [{ skillKey, difficulty, seed }] - the fixed question list
  passed         Boolean? // mastery only
  totalQuestions Int
  correctCount   Int       @default(0)
  answeredCount  Int       @default(0)
  breakdown      String? // JSON string: { [skillKey]: { correct, total } }
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([startedAt])
}
