// Prisma schema for Allie's Math Practice
// SQLite locally; swap the datasource provider + DATABASE_URL to Postgres/Turso for production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Skill {
  id       String    @id @default(cuid())
  strand   String // "RP" | "NS" | "EE" | "G" | "SP"
  key      String    @unique
  name     String
  order    Int
  attempts Attempt[]
}

model Attempt {
  id            String   @id @default(cuid())
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id])
  sessionId     String?
  mode          String // "practice" | "quiz" | "test"
  difficulty    Int
  prompt        String
  userAnswer    String
  correctAnswer String
  correct       Boolean
  createdAt     DateTime @default(now())

  @@index([skillId])
  @@index([sessionId])
  @@index([createdAt])
}

model AssessmentSession {
  id             String    @id @default(cuid())
  mode           String // "quiz" | "test"
  totalQuestions Int
  correctCount   Int       @default(0)
  answeredCount  Int       @default(0)
  breakdown      String? // JSON string: { [skillKey]: { correct, total } }
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([startedAt])
}
